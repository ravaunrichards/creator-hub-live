# Copy to backend/.env for local development; never commit real credentials.
PORT=3000

# Comma-separated exact origins allowed to call this backend from browsers.
# Add your deployed frontend origin and the Android WebView asset origin.
FRONTEND_URL=https://your-frontend.onrender.com,https://appassets.androidplatform.net

# Backend service configuration — replace every placeholder in your deployment environment.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

LIVEKIT_URL=wss://YOUR-LIVEKIT-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Use sandbox until test purchases have been verified. Use live only when ready.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=https://your-frontend.onrender.com
