PORT=3000
FRONTEND_URL=https://your-deployed-frontend.example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret
PAYPAL_WEBHOOK_ID=replace_with_paypal_webhook_id
# Optional override; otherwise backend uses FRONTEND_URL. Not a PayPal Developer Dashboard field.
# PAYPAL_RETURN_URL=https://your-deployed-frontend.example.com

# Optional LIVE recording support (configure a private S3-compatible bucket before use).
# LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET above are also required.
LIVE_RECORDING_S3_BUCKET=
LIVE_RECORDING_S3_REGION=
LIVE_RECORDING_S3_ACCESS_KEY=
LIVE_RECORDING_S3_SECRET_KEY=
LIVE_RECORDING_S3_ENDPOINT=
LIVE_RECORDING_S3_FORCE_PATH_STYLE=false
LIVE_RECORDING_CLEANUP_SECRET=
