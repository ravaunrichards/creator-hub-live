# Creator Hub Creator Network backend environment template.
# Copy this file to backend/.env and replace placeholders with real values.
# Never commit backend/.env or share real credentials.

# HTTP server
PORT=3000
FRONTEND_URL=https://creator-hub-live-frontend.onrender.com
NEXT_PUBLIC_APP_URL=http://localhost:8080

# Supabase — server-side backend credentials
SUPABASE_URL=https://replace_with_supabase_project_url
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
# Optional compatibility aliases if your existing deployment uses them:
# SUPABASE_KEY=replace_with_supabase_anon_key
# NEXT_PUBLIC_SUPABASE_URL=https://txibryhznycmuqufnxvh.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR4aWJyeWh6bnljbXVxdWZueHZoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEzMTE3MDUsImV4cCI6MjEwNjg4NzcwNX0.NbNOmsPj3sO9y3bOm0XBoE5QpBICAVIV36f8rH_S-qc

# LiveKit — required for authenticated LIVE token and room operations
LIVEKIT_URL=wss://replace_with_livekit_url
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret

# PayPal — configure sandbox first; switch to live only after verifying credentials
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret
PAYPAL_WEBHOOK_ID=replace_with_paypal_webhook_id
PAYPAL_RETURN_URL=https://creator-hub-live-frontend.onrender.com

# Optional LIVE recording storage (private S3-compatible bucket + LiveKit Egress)
# Leave unset until private bucket access and Egress are configured.
# LIVE_RECORDING_S3_BUCKET=replace_with_private_recording_bucket
# LIVE_RECORDING_S3_REGION=replace_with_storage_region
# LIVE_RECORDING_S3_ACCESS_KEY=replace_with_storage_access_key
# LIVE_RECORDING_S3_SECRET_KEY=replace_with_storage_secret_key
# LIVE_RECORDING_S3_ENDPOINT=https://replace_with_s3_compatible_endpoint
# LIVE_RECORDING_S3_FORCE_PATH_STYLE=true
# Alternative AWS SDK aliases accepted by the backend:
# AWS_REGION=replace_with_storage_region
# AWS_ACCESS_KEY_ID=replace_with_storage_access_key
# AWS_SECRET_ACCESS_KEY=replace_with_storage_secret_key
# Required only if the recording-cleanup endpoint/cron is configured:
# LIVE_RECORDING_CLEANUP_SECRET=replace_with_a_long_random_cleanup_secret
